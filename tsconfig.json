{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "cypress"],
    "noEmit": true
  },
  "include": ["playwright", "cypress", "scripts", "*.ts"]
}
