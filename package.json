  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/i-MartinX/BeonTech-test/issues"
  },
  "homepage": "https://github.com/i-MartinX/BeonTech-test#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "cross-env": "^10.1.0",
    "cypress": "^16.2.1",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
