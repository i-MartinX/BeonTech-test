{
  "name": "beontech-poc",
  "version": "1.0.0",
  "description": "BEON.Tech",
  "scripts": {
    "test:pw": "playwright test",
    "test:cy": "cypress run",
    "test:all": "tsx scripts/run-all.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('reports',{recursive:true,force:true})\"",
    "merge": "tsx scripts/merge-results.ts",
    "test:pw:update": "playwright test --update-snapshots",
    "test:cy:update": "cross-env UPDATE_SNAPSHOTS=1 cypress run"
  },
